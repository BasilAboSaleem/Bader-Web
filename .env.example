##
## Bader Humanitarian — Environment Configuration
## Copy to .env and fill in production values before deploying.
##

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="بادر الإنسانية"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://baderhumanitarian.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# ── Security ───────────────────────────────────────────────────────────────────
# Higher bcrypt cost is appropriate for production.
BCRYPT_ROUNDS=12

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────────
# Laravel Cloud injects these automatically when a database is attached.
# For self-hosted MySQL, fill in the values below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bader
DB_USERNAME=bader
DB_PASSWORD=

# ── Cache, Sessions & Queues ───────────────────────────────────────────────────
# Laravel Cloud: use "database" until a Valkey/Redis cache is attached.
# Upgrade CACHE_STORE and SESSION_DRIVER to "redis" when Valkey is available.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.baderhumanitarian.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Redis / Valkey (Laravel Cloud attaches automatically) ──────────────────────
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
# Use SMTP in production. Fill credentials from your email provider.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@baderhumanitarian.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object Storage (Laravel Cloud / AWS S3 / Cloudflare R2) ───────────────────
# Cloud attaches and injects these automatically. For manual setup:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=bader-media
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
