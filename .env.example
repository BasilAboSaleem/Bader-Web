##
## Bader Humanitarian — Environment Configuration
## Copy to .env and fill in production values before deploying (Cloudways: Application → .env via SSH/SFTP).
##

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="بادر الإنسانية"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://baderhumanitarian.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# ── Security ───────────────────────────────────────────────────────────────────
# Higher bcrypt cost is appropriate for production.
BCRYPT_ROUNDS=12

# Owner account, created once with: php artisan db:seed --class=SuperAdminSeeder --force
# Only this account can add or remove other dashboard administrators.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────────────
# Cloudways: copy the values from Application → Access Details → MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ── Cache, Sessions & Queues ───────────────────────────────────────────────────
# "database" works out of the box. Switch to "redis" after enabling Redis in Cloudways.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave empty so logins work on both the temporary *.cloudwaysapps.com URL and the real domain.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Redis (optional, Cloudways → Server → Settings & Packages → Redis) ─────────
# CACHE_STORE=redis
# SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
# The site does not send emails yet (form submissions land in the dashboard inbox).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@baderhumanitarian.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Online Donations (Stripe) ─────────────────────────────────────────────────
# Leave STRIPE_SECRET empty to disable card payments (bank transfer stays available).
# Webhook endpoint to register in Stripe: https://YOUR-DOMAIN/donate/webhook
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ── Vite ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
